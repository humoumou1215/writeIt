{
  "name": "writeit-v2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22 <24"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "npm run test:unit",
    "test:unit": "npm run check:boundaries && vitest run",
    "test:browser": "playwright test",
    "test:watch": "vitest",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:goal-contract": "node scripts/check-goal-contract.mjs",
    "typecheck": "vue-tsc --noEmit",
    "verify:fast": "npm run check:goal-contract && npm run test && npm run build",
    "verify": "npm run check:goal-contract && npm run test && npm run test:browser && npm run build"
    ,"desktop:package-smoke": "npm run build && node scripts/desktop-package-smoke.mjs"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.13.10",
    "@vitejs/plugin-vue": "^6.0.8",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.2.12"
  }
}
